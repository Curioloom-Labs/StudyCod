# Example environment variables (safe to commit)
# Copy to .env and fill in values.

# --- App mode ---
NODE_ENV=development

# --- Backend ---
PORT=4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Auth (required in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Database (either DATABASE_URL or discrete params)
# DATABASE_URL=mysql://user:pass@host:3306/dbname
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=CHANGE_ME
DB_NAME=studycod
DB_POOL_SIZE=10

# OpenRouter AI
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_BACKUP_API_KEYS=KEY1,KEY2
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_REFERER=https://studycod.app

# Judge worker / sandbox (Linux prod)
JUDGE_WORKER_ENTRY=/absolute/path/to/judge/worker/entry.js
NSJAIL_PATH=/usr/bin/nsjail
NSJAIL_CONFIG=/absolute/path/to/nsjail.cfg
# IMPORTANT (production hardening): must be 1 in production.
NSJAIL_USE_CONFIG=1
NSJAIL_CWD=/work
NSJAIL_CHROOT=/sandbox/rootfs
NSJAIL_CHROOT_JAVA=/sandbox/java
NSJAIL_CHROOT_CPP=/sandbox/cpp
NSJAIL_CHROOT_PYTHON=/sandbox/python
JUDGE_LOCK_PATH=/tmp/studycod-judge.lock
JUDGE_LOCK_STALE_MS=120000

# Optional: run judge smoke tests (Linux only)
RUN_JUDGE_SMOKE_TESTS=0
