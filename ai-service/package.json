{
  "name": "studycod-ai-service",
  "version": "1.0.0",
  "description": "StudyCod AI Service - Internal AI processing service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_PATH=../shared:../backend/src ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_PATH=../shared:../backend/src node -r tsconfig-paths/register dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.3",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "cross-env": "^10.1.0",
    "module-alias": "^2.3.4"
  },
  "_moduleAliases": {
    "@shared": "../shared",
    "services": "../backend/src/services",
    "utils": "../backend/src/utils",
    "entities": "../backend/src/entities",
    "config": "../backend/src/config"
  }
}

