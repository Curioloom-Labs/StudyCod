{
  "name": "studycod-backend",
  "version": "1.0.0",
  "description": "StudyCod backend (Node.js + TypeScript + TypeORM + MySQL + OpenRouter)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ./node_modules/typescript/lib/tsc.js",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/scripts/runMigrations.ts",
    "db:bootstrap-migration-history": "tsx src/scripts/bootstrapMigrationHistory.ts",
    "test": "cross-env NODE_ENV=test npm run build && cross-env NODE_ENV=test node --test \"dist/**/*.test.js\"",
    "test:judge-contract": "node run-judge-contract-test.js",
    "test:db-contract": "node run-db-contract-test.js",
    "loadtest": "node loadtest/run.js",
    "brevo:check": "node brevo-key-check.js",
    "email:test:batch": "node send-batch-test.js",
    "email:test:smtp": "node send-test-email.js",
    "sanitize-templates": "npm run build && node dist/backend/src/scripts/sanitizeTemplates.js",
    "fix-missing-output-format": "npm run build && node dist/backend/src/scripts/fixMissingOutputFormat.js"
  },
  "dependencies": {
    "@types/express-session": "^1.18.2",
    "@types/nodemailer": "^7.0.9",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^8.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.1",
    "geoip-lite": "^2.0.3",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "imapflow": "^1.0.190",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.4",
    "mailparser": "^3.9.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.17.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "playwright": "^1.54.2",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
